"""SecondDNS offline queue delivery worker.

Watches the local operation queue (SQLite) and delivers zone operations to
the SecondDNS API in strict FIFO order. When the API is unreachable (outage
or maintenance) it backs off exponentially and retries until the queue is
drained. Panel hooks only INSERT into the queue — this worker is the single
delivery path.

Usage:
  seconddns-queued            # daemon mode (systemd service)
  seconddns-queued --once     # drain once and exit (manual flush);
                              # exit 0 = drained, 1 = API unavailable

Configuration (/etc/seconddns.conf):
  [seconddns]
  api_url = https://seconddns.com
  api_key = ...

  [queue]                # optional, defaults shown
  poll_interval = 60     # fallback idle tick, seconds (wakeups are event-driven
                         # via the unix socket, this only guards lost wakeups)
  http_timeout = 15      # seconds per API request
  backoff_min = 30       # first retry delay when the API is down
  backoff_max = 28800    # retry delay ceiling (8 h)

The queue CLI wakes the worker instantly after every enqueue by sending a
datagram to the unix socket (/var/lib/seconddns/queued.sock).

Environment overrides (tests): SECONDDNS_CONF, SECONDDNS_QUEUE_DB,
SECONDDNS_LOG, SECONDDNS_QUEUE_SOCK.
"""

import configparser
import fcntl
import json
import os
import signal
import socket
import sqlite3
import sys
import time
import urllib.error
import urllib.request

CONF = os.environ.get("SECONDDNS_CONF", "/etc/seconddns.conf")
QDB = os.environ.get("SECONDDNS_QUEUE_DB", "/var/lib/seconddns/queue.db")
SOCK = os.environ.get("SECONDDNS_QUEUE_SOCK", "/var/lib/seconddns/queued.sock")
LOCK = os.environ.get("SECONDDNS_QUEUE_LOCK", QDB + ".lock")
LOG = os.environ.get("SECONDDNS_LOG", "/var/log/seconddns.log")
UA = "SecondDNS-QueueWorker/1.0"

SCHEMA = """
CREATE TABLE IF NOT EXISTS ops (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  ts TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ','now')),
  op TEXT NOT NULL,
  domain TEXT NOT NULL,
  master_ip TEXT,
  attempts INTEGER NOT NULL DEFAULT 0,
  status TEXT NOT NULL DEFAULT 'pending',
  last_error TEXT
);
"""

DONE, RETRY, FAILED = 0, 1, 2

running = True


def log(msg):
    line = f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}\n"
    try:
        with open(LOG, "a") as f:
            f.write(line)
    except OSError:
        sys.stderr.write(line)


def load_config():
    cp = configparser.ConfigParser()
    cp.read(CONF)
    api_url = cp.get("seconddns", "api_url", fallback="").strip()
    api_key = cp.get("seconddns", "api_key", fallback="").strip()
    if not api_url or not api_key:
        log("[!] worker: api_url/api_key not configured, exiting")
        sys.exit(0)
    return {
        "api_url": api_url.rstrip("/"),
        "api_key": api_key,
        "delete_check_master_ip": cp.getboolean("seconddns", "delete_check_master_ip", fallback=True),
        "poll_interval": cp.getint("queue", "poll_interval", fallback=60),
        "http_timeout": cp.getint("queue", "http_timeout", fallback=15),
        "backoff_min": cp.getint("queue", "backoff_min", fallback=30),
        "backoff_max": cp.getint("queue", "backoff_max", fallback=28800),
    }


def wake_socket():
    """Bind the wakeup socket; enqueue-side sends a datagram after INSERT."""
    os.makedirs(os.path.dirname(SOCK) or ".", exist_ok=True)
    try:
        os.unlink(SOCK)
    except FileNotFoundError:
        pass
    sk = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    # bind via a relative path: AF_UNIX paths are limited to ~104 bytes
    cwd = os.getcwd()
    try:
        os.chdir(os.path.dirname(SOCK) or ".")
        sk.bind(os.path.basename(SOCK))
    finally:
        os.chdir(cwd)
    os.chmod(SOCK, 0o660)
    return sk


def wait_for_wakeup(sk, timeout):
    """Sleep until a wakeup datagram arrives or the fallback tick fires.
    Returns True when woken by a datagram."""
    sk.settimeout(timeout)
    woken = False
    try:
        sk.recv(16)
        woken = True
        # absorb any burst of wakeups queued while we were busy
        sk.settimeout(0)
        while True:
            sk.recv(16)
    except (socket.timeout, BlockingIOError, InterruptedError, OSError):
        pass
    return woken


def send_wakeup():
    """Client side of the wakeup socket (used by --once when the daemon holds the lock)."""
    cwd = os.getcwd()
    try:
        os.chdir(os.path.dirname(SOCK) or ".")
        s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        s.sendto(b"1", os.path.basename(SOCK))
        return True
    except OSError:
        return False
    finally:
        os.chdir(cwd)


def db():
    os.makedirs(os.path.dirname(QDB), exist_ok=True)
    conn = sqlite3.connect(QDB, timeout=5)
    conn.execute("PRAGMA journal_mode=WAL")
    conn.executescript(SCHEMA)
    return conn


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """A 30x is an answer from something in front of the API (maintenance
    switch, proxy); surface it as-is instead of fetching the target."""
    def redirect_request(self, *args, **kwargs):
        return None


OPENER = urllib.request.build_opener(_NoRedirect)


def queue_lock(block):
    """Exclusive lock shared by every drainer. Returns fd, or None if busy."""
    fd = os.open(LOCK, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | (0 if block else fcntl.LOCK_NB))
    except BlockingIOError:
        os.close(fd)
        return None
    return fd


def api(cfg, method, path, payload=None):
    """Returns (status_code, body_dict). status 0 = no usable answer from the API."""
    url = cfg["api_url"] + path
    body = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(url, data=body, method=method, headers={
        "X-API-Key": cfg["api_key"],
        "Content-Type": "application/json",
        "User-Agent": UA,
    })
    try:
        with OPENER.open(req, timeout=cfg["http_timeout"]) as resp:
            raw = resp.read()
            try:
                data = json.loads(raw) if raw else {}
            except ValueError:
                return 0, {"error": f"HTTP {resp.status} with non-JSON body (proxy or maintenance page?)"}
            return resp.status, data
    except urllib.error.HTTPError as e:
        try:
            data = json.loads(e.read())
        except Exception:
            data = {}
        return e.code, data
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        return 0, {"error": f"network: {e}"}


def detail(code, data):
    if code == 0:
        return data.get("error", "no response")
    if code in (401, 403):
        return f"HTTP {code} auth rejected"
    return f"HTTP {code}"


def send_op(cfg, op, domain, master_ip):
    """Deliver one operation. Returns (DONE / RETRY / FAILED, detail string)."""
    if op == "create":
        code, data = api(cfg, "POST", "/api/zones",
                         {"name": domain, "masterIp": master_ip})
        if code in (200, 201):
            return DONE, detail(code, data)
        if code == 409:
            # exists: under this key on another master (migration pending),
            # or under another account on the same DNS server
            gcode, zone = api(cfg, "GET", f"/api/zones/by-name/{domain}")
            owner = zone.get("masterIp") if gcode == 200 else None
            if gcode == 404:
                log(f"[!] worker: zone {domain} exists under another account on this DNS server (treated as done)")
            elif owner and master_ip and owner != master_ip:
                log(f"[!] worker: zone {domain} exists, mastered by {owner} not {master_ip} — run seconddns-migrate-master (treated as done)")
            else:
                log(f"[~] worker: zone {domain} already exists (treated as success)")
            return DONE, detail(code, data)
        if code in (400, 422):
            return FAILED, detail(code, data)
        return RETRY, detail(code, data)

    if op == "delete":
        code, zone = api(cfg, "GET", f"/api/zones/by-name/{domain}")
        if code == 404:
            log(f"[~] worker: zone {domain} already absent (treated as success)")
            return DONE, detail(code, zone)
        if code in (400, 422):
            return FAILED, detail(code, zone)
        if code == 200 and not zone.get("id"):
            log(f"[!] worker: zone {domain} lookup returned 200 without id")
            return FAILED, "HTTP 200 without id"
        if code != 200:
            return RETRY, detail(code, zone)
        owner = zone.get("masterIp")
        if master_ip and owner and owner != master_ip and cfg["delete_check_master_ip"]:
            log(f"[~] worker: zone {domain} is mastered by {owner}, not {master_ip} — delete skipped")
            return DONE, f"skipped, mastered by {owner}"
        code, data = api(cfg, "DELETE", f"/api/zones/{zone['id']}")
        if code in (200, 204, 404):
            return DONE, detail(code, data)
        if code in (400, 422):
            return FAILED, detail(code, data)
        return RETRY, detail(code, data)

    return FAILED, f"unknown op {op}"


def drain(cfg, conn, once, sk=None):
    """Process pending ops in FIFO order.

    Returns True when the queue is empty, False when delivery must pause
    (API unavailable).
    """
    backoff = cfg["backoff_min"]
    while running:
        row = conn.execute(
            "SELECT id, op, domain, IFNULL(master_ip,'') FROM ops"
            " WHERE status='pending' ORDER BY id LIMIT 1").fetchone()
        if row is None:
            return True
        rid, op, domain, master_ip = row

        result, why = send_op(cfg, op, domain, master_ip)
        if result == DONE:
            conn.execute("DELETE FROM ops WHERE id=?", (rid,))
            conn.commit()
            if why.startswith("skipped"):
                log(f"[~] worker: completed {op} {domain} ({why})")
            else:
                log(f"[+] worker: delivered {op} {domain}")
            backoff = cfg["backoff_min"]
        elif result == FAILED:
            conn.execute(
                "UPDATE ops SET status='failed', attempts=attempts+1,"
                " last_error=? WHERE id=?", (why, rid))
            conn.commit()
            log(f"[!] worker: {op} {domain} permanently failed ({why})")
        else:  # RETRY — API unavailable, keep FIFO order and wait
            conn.execute(
                "UPDATE ops SET attempts=attempts+1, last_error=? WHERE id=?",
                (why, rid))
            conn.commit()
            pending = conn.execute(
                "SELECT COUNT(*) FROM ops WHERE status='pending'").fetchone()[0]
            what = "API key rejected" if "auth rejected" in why else "API unavailable"
            log(f"[~] worker: {what} ({why}),"
                f" {pending} op(s) waiting, retry in {backoff}s")
            if once:
                return False
            # a new enqueue (or a flush) cuts the wait short: retry right away
            deadline = time.time() + backoff
            woken = False
            while running and not woken and time.time() < deadline:
                if sk is not None:
                    woken = wait_for_wakeup(sk, min(1, max(0, deadline - time.time())))
                else:
                    time.sleep(1)
            if woken:
                log("[~] worker: woken up, retrying now")
            backoff = min(backoff * 2, cfg["backoff_max"])
    return False


def main():
    once = "--once" in sys.argv
    cfg = load_config()
    conn = db()

    def stop(_sig, _frm):
        global running
        running = False
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    if once:
        fd = queue_lock(block=False)
        if fd is None:
            if send_wakeup():
                log("[~] worker: another drainer holds the queue lock, sent it a wakeup")
                print("queue is being drained by another process; asked it to retry now")
            else:
                log("[~] worker: another drainer holds the queue lock, nothing to do")
                print("queue is being drained by another process")
            sys.exit(0)
        sys.exit(0 if drain(cfg, conn, once=True) else 1)

    sk = wake_socket()
    log("[*] worker: started")
    while running:
        fd = queue_lock(block=True)
        try:
            drain(cfg, conn, once=False, sk=sk)
        finally:
            os.close(fd)
        wait_for_wakeup(sk, cfg["poll_interval"])
    try:
        os.unlink(SOCK)
    except OSError:
        pass
    log("[*] worker: stopped")


if __name__ == "__main__":
    main()
