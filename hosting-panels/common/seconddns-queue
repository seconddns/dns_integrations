# SecondDNS offline operation queue — CLI.
#
# Panel hooks enqueue zone operations into a local SQLite queue; the
# seconddns-queued systemd worker delivers them to the SecondDNS API in
# strict FIFO order (surviving outages and maintenance windows).
#
# Usage:
#   seconddns-queue enqueue <create|delete> <domain> [master_ip]
#   seconddns-queue flush             # manual one-shot drain (diagnostics)
#   seconddns-queue status [--json]
#
# Exit codes for status: 0 = empty/healthy, 1 = pending backlog, 2 = failed ops
#
# Environment overrides (mainly for tests):
#   SECONDDNS_QUEUE_DB    sqlite db path (default /var/lib/seconddns/queue.db)
#   SECONDDNS_LOG         log file       (default /var/log/seconddns.log)

set -u

QDB="${SECONDDNS_QUEUE_DB:-/var/lib/seconddns/queue.db}"
QSOCK="${SECONDDNS_QUEUE_SOCK:-/var/lib/seconddns/queued.sock}"
LOG="${SECONDDNS_LOG:-/var/log/seconddns.log}"
WORKER="${SECONDDNS_QUEUED_BIN:-/usr/local/bin/seconddns-queued}"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $1" >> "$LOG"; }

sq() {
    sqlite3 -cmd ".timeout 5000" "$QDB" "$@"
}

init_db() {
    mkdir -p "$(dirname "$QDB")"
    sq "PRAGMA journal_mode=WAL;
        CREATE TABLE IF NOT EXISTS ops (
          id INTEGER PRIMARY KEY AUTOINCREMENT,
          ts TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ','now')),
          op TEXT NOT NULL,
          domain TEXT NOT NULL,
          master_ip TEXT,
          attempts INTEGER NOT NULL DEFAULT 0,
          status TEXT NOT NULL DEFAULT 'pending',
          last_error TEXT
        );" >/dev/null
}

# Lowercase, strip surrounding whitespace and the trailing root dot.
# DNS names are case-insensitive; the queue stores one canonical form so
# duplicate delivery and FIFO ordering compare equal across panels.
normalize_domain() {
    local d="$1"
    d="${d#"${d%%[![:space:]]*}"}"
    d="${d%"${d##*[![:space:]]}"}"
    d="${d%.}"
    printf '%s' "$d" | tr '[:upper:]' '[:lower:]'
}

# Non-ASCII names reach us unconverted from some panels (CyberPanel), so the
# queue converts to Punycode itself; ASCII names pass through untouched.
to_punycode() {
    local d="$1"
    case "$d" in
        *[!!-~]*) ;;
        *) printf '%s' "$d"; return 0 ;;
    esac
    if command -v idn2 >/dev/null 2>&1; then
        idn2 --quiet "$d" 2>/dev/null && return 0
    elif command -v idn >/dev/null 2>&1; then
        idn --quiet "$d" 2>/dev/null && return 0
    fi
    python3 -c 'import sys; print(".".join(l.encode("idna").decode() for l in sys.argv[1].split(".")))' "$d" 2>/dev/null
}

# LDH per RFC 1035: labels of a-z0-9 and inner hyphens, 1-63 each, 253 total.
# Case-insensitive so the check stands on its own, without assuming that
# normalize_domain ran first.
valid_domain() {
    local d="$1" label
    [ -n "$d" ] || return 1
    [ "${#d}" -le 253 ] || return 1
    case "$d" in *.*) ;; *) return 1 ;; esac
    local IFS='.'
    for label in $d; do
        [ -n "$label" ] || return 1
        [ "${#label}" -le 63 ] || return 1
        case "$label" in
            -*|*-) return 1 ;;
            *[!a-zA-Z0-9-]*) return 1 ;;
        esac
    done
    return 0
}

valid_ip() {
    local ip="$1"
    case "$ip" in
        *[!0-9a-fA-F.:]*) return 1 ;;
        *:*) return 0 ;;
    esac
    local IFS='.' octet count=0
    for octet in $ip; do
        count=$((count + 1))
        case "$octet" in ""|*[!0-9]*) return 1 ;; esac
        [ "$octet" -le 255 ] || return 1
    done
    [ "$count" -eq 4 ]
}

# SQL literal quoting: '' escapes a single quote inside a sqlite3 string.
sql_quote() {
    local v="$1"
    printf "'%s'" "${v//\'/\'\'}"
}

cmd_enqueue() {
    local op="$1" domain master_ip="${3:-}"
    case "$op" in
        create|delete) ;;
        *) log "[!] queue: refused unknown op '$op'"; return 2 ;;
    esac
    domain=$(normalize_domain "$2")
    domain=$(to_punycode "$domain")
    if [ -z "$domain" ] || ! valid_domain "$domain"; then
        log "[!] queue: refused invalid domain '$2'"
        return 2
    fi
    if [ -n "$master_ip" ] && ! valid_ip "$master_ip"; then
        log "[!] queue: refused invalid master_ip '$master_ip' for $domain"
        return 2
    fi
    init_db
    sq "INSERT INTO ops (op, domain, master_ip) VALUES ($(sql_quote "$op"), $(sql_quote "$domain"), $(sql_quote "$master_ip"));" >/dev/null || {
        log "[!] queue: enqueue failed for $op $domain"
        return 1
    }
    log "[>] queue: enqueued $op $domain"
    # wake the delivery worker instantly (best-effort)
    python3 -c "
import socket, os
os.chdir(os.path.dirname('$QSOCK') or '.')  # AF_UNIX ~104-byte path limit
s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
s.sendto(b'1', os.path.basename('$QSOCK'))
" 2>/dev/null || true
}

cmd_status() {
    init_db
    local pending failed oldest_age
    pending=$(sq "SELECT COUNT(*) FROM ops WHERE status='pending';")
    failed=$(sq "SELECT COUNT(*) FROM ops WHERE status='failed';")
    oldest_age=$(sq "SELECT IFNULL(CAST(strftime('%s','now') - strftime('%s', MIN(ts)) AS INTEGER), 0) FROM ops WHERE status='pending';")
    if [ "${1:-}" = "--json" ]; then
        echo "{\"pending\": $pending, \"failed\": $failed, \"oldest_age_seconds\": $oldest_age}"
    else
        echo "pending=$pending failed=$failed oldest_age_seconds=$oldest_age"
    fi
    [ "$failed" -gt 0 ] && exit 2
    [ "$pending" -gt 0 ] && exit 1
    exit 0
}

# Sourced by the test suite to exercise the helpers directly.
[ -n "${SECONDDNS_QUEUE_LIB:-}" ] && return 0

case "${1:-}" in
  enqueue)
    [ $# -ge 3 ] || { echo "usage: $0 enqueue <create|delete> <domain> [master_ip]" >&2; exit 1; }
    cmd_enqueue "$2" "$3" "${4:-}"
    ;;
  flush)  exec "$WORKER" --once ;;
  status) cmd_status "${2:-}" ;;
  *)
    echo "usage: $0 enqueue|flush|status" >&2
    exit 1
    ;;
esac
